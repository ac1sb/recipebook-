# Copy this file to .env and fill in whichever keys you have.
# The app works with no keys at all (TheMealDB + recipe-URL import + rule-based tweaks).

# Enables "search the whole web" for recipes and smart feedback-driven alterations.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: Spoonacular aggregates recipes from thousands of blogs and sites.
# Free key: https://spoonacular.com/food-api/console
SPOONACULAR_API_KEY=

# Optional: Edamam recipe search (millions of recipes from many publishers).
# Free key: https://developer.edamam.com/edamam-recipe-api
EDAMAM_APP_ID=
EDAMAM_APP_KEY=

# Optional: ask for this password before showing the site (any username works).
APP_PASSWORD=

PORT=3000
